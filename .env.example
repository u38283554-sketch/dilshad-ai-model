# AI Provider configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-3.7-flash

# GEMINI_API_KEY: Preferred secure server-side key for Gemini calls.
# Configure this in Netlify environment variables. Do not expose it in frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Compatibility fallback for existing Netlify setups. The server-side function can
# read this name, but the frontend must not access it through import.meta.env.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
